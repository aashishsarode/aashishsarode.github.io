{% assign repo_url = include.repository.repository | split: '/' %}
<article class="repo-card">
  <div class="repo-card-header">
    <span class="repo-card-index">0{{ forloop.index }}</span>
    <span class="repo-card-type">GitHub repository</span>
  </div>
  <h2>{{ include.repository.name }}</h2>
  <p>{{ include.repository.description }}</p>
  <div class="repo-card-footer">
    <span class="repo-card-language">{{ include.repository.language }}</span>
    <a href="https://github.com/{{ include.repository.repository }}">View repository <span aria-hidden="true">-&gt;</span></a>
  </div>
  {% if include.repository.topics %}
    <div class="repo-card-topics">
      {% for topic in include.repository.topics %}
        <span>{{ topic }}</span>
      {% endfor %}
    </div>
  {% endif %}
</article>
